# Server listening port
PORT=8888

# Secret token to protect your archiver API (generate with: openssl rand -hex 20)
API_TOKEN=change_me_to_a_secure_random_token

# Public URL of your VPS archiver (IP or domain name)
BASE_URL=http://YOUR_VPS_IP:8888

# Directory where snapshots are stored
STORAGE_DIR=./snapshots

# Retention policy: Auto-delete snapshots older than N days (default: 90)
RETENTION_DAYS=90
