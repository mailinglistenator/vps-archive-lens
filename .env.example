# ==============================================================================
# VPS Archive Lens - Environment Configuration Template
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. CORE SERVER SETTINGS
# ------------------------------------------------------------------------------
# Port the FastAPI archiver daemon listens on
PORT=8888

# Secret API Token for single-admin authentication (backward-compatible).
# When set, requests require this token via Header, Query param, or Cookie.
# Generate a strong token with: openssl rand -hex 20
API_TOKEN=change_me_to_a_secure_random_token

# Multi-User Tokens (Optional - alternate to API_TOKEN or web dashboard user management):
# Seed multiple distinct user accounts on startup.
# Format: username:token:role (role can be 'admin' or 'user', default is 'user' except first user)
# Example: USER_TOKENS="admin:secret_admin_token:admin, friend:friend_token:user, family:family_token:user"
# You can also manage users interactively via:
#   python3 server/manage_users.py add <username> [--role user|admin]
#   python3 server/manage_users.py list
#   python3 server/manage_users.py revoke <username>
# Or via the 'Access & Users' tab in the VPS Power Hub dashboard!
# USER_TOKENS=

# The public base URL of your archiver (IP:port, domain, or tunnel URL).
# Used to construct absolute snapshot and reader view links returned to the extension.
BASE_URL=http://YOUR_VPS_IP:8888

# Directory where HTML snapshots, metadata, and cached images are stored
STORAGE_DIR=./snapshots

# Directory where downloaded media (MP4 videos, MP3 audio) is stored
# MEDIA_STORAGE_DIR=./videos

# Path to YouTube cookies file for bypassing datacenter bot checks (optional)
# YOUTUBE_COOKIES_PATH=./cookies.txt

# Retention policy: Auto-prune snapshots and cached images older than N days (default: 90)
RETENTION_DAYS=90

# ------------------------------------------------------------------------------
# 2. AI READER VIEW & KEY TAKEAWAYS (OPTIONAL)
# ------------------------------------------------------------------------------
# VPS Archive Lens automatically detects local Hermes credentials if installed:
# - ~/.hermes/auth.json -> Nous Research Free Tier (upstage/solar-pro4:free)
# - ~/.hermes/config.yaml -> NeuralWatt GLM-5.2
#
# If running standalone (or outside Hermes), configure one of the providers below.
# If no provider is configured, Reader View uses high-quality heuristic extraction.

# Option A: OpenCode Go / Zen
# OPENCODE_GO_API_KEY=your_opencode_key_here
# OPENCODE_GO_BASE_URL=https://opencode.ai/zen/go/v1

# Option B: NeuralWatt (GLM-5.2)
# NEURALWATT_API_KEY=your_neuralwatt_key_here
# NEURALWATT_BASE_URL=https://api.neuralwatt.com/v1
# NEURALWATT_MODEL=glm-5.2

# Option C: OpenRouter (Free or Paid Models)
# OPENROUTER_API_KEY=your_openrouter_key_here

# Option D: Generic OpenAI-Compatible Endpoint (Ollama, vLLM, DeepSeek, LocalAI, OpenAI)
# AI_BASE_URL=http://localhost:11434/v1
# AI_API_KEY=optional_api_key
# AI_MODEL=llama3.2
